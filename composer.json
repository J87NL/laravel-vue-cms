{
    "name": "j87nl/laravel-vue-cms",
    "description": "Vue and Inertia admin for j87nl/laravel-cms.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "cms",
        "inertia",
        "vue",
        "admin"
    ],
    "homepage": "https://github.com/J87NL/laravel-vue-cms",
    "authors": [
        {
            "name": "Johan Montenij",
            "homepage": "https://j87.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/J87NL/laravel-vue-cms/issues",
        "source": "https://github.com/J87NL/laravel-vue-cms"
    },
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.0",
        "inertiajs/inertia-laravel": "^3.0",
        "j87nl/laravel-cms": "^0.6 || ^0.7 || ^0.8",
        "tranquil-tools/laravel-vue-form-builder": "^1.10",
        "tranquil-tools/laravel-vue-table-builder": "^1.9"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "J87NL\\VueCms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "J87NL\\VueCms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "J87NL\\VueCms\\VueCmsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
